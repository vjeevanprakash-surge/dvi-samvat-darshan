{
  "expo": {
    "name": "Samvat",
    "slug": "samvat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vjeevanprakash.samvat"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2A2563",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vjeevanprakash.samvat"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Samvat uses your location to compute sunrise, sunset and panchang timings for where you are."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#2A2563"
        }
      ]
    ],
    "scheme": "samvat",
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/dvi-samvat-darshan"
    },
    "extra": {
      "eas": {
        "projectId": "330c77c5-15cc-4881-9006-14be3d655d87"
      }
    },
    "owner": "jeev.prakash"
  }
}
